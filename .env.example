# =============================================================================
# OptimalBot Portal Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Read by the backend (app.py), the bot (bot.py), the eval runners (evals/)
# and the helper scripts (scripts/). Variables marked "Required" make
# validate.py or the process itself refuse to start when they are missing.
# The frontend has its own file: frontend/.env.example.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Environment mode: "local", "test" or "production".
# local: backend starts calls on the local bot server (LOCAL_BOT_URL).
# test / production: backend starts calls through Pipecat Cloud and requires PIPECAT_API_KEY.
ENV=local

# Backend server port
PORT=8000

# Verbose logging for the backend and the bot (true/false)
DEBUG=false

# Extra-verbose TRACE-level log lines (true/false)
TRACE=false

# Version string reported by the /health/detailed endpoint (optional)
# APP_VERSION=dev

# Directory the onboarding API reads and writes client folders in (optional, defaults to ./clients)
# CLIENTS_BASE_PATH=./clients

# -----------------------------------------------------------------------------
# MongoDB (Required)
# -----------------------------------------------------------------------------
# MongoDB connection string
# Format: mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=<your-mongodb-connection-string>

# Database name. The eval runners override this to "alfons_test".
MONGO_DB_NAME=alfons

# Connection pool size (optional)
MONGO_MAX_POOL_SIZE=10

# How long to wait for a MongoDB server before failing, in milliseconds (optional)
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Authentication and CORS (Required, backend)
# -----------------------------------------------------------------------------
# Secret used to sign JWTs. Must be at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<your-jwt-secret-key>

# Comma-separated list of origins the backend allows for CORS
# Example: http://localhost:3000,https://yourapp.com
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# OpenAI (Required, bot)
# -----------------------------------------------------------------------------
# Main conversation LLM, observer LLM, and the caller simulator in the evals
# https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-api-key>

# -----------------------------------------------------------------------------
# Groq (Required, bot)
# -----------------------------------------------------------------------------
# Fast classifier LLM (voicemail/IVR/human triage) and Llama Guard safety checks
# https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>

# -----------------------------------------------------------------------------
# Anthropic (Required for evals only)
# -----------------------------------------------------------------------------
# LLM grader in every evals/ runner. The bot can also use "provider: anthropic"
# in a services.yaml, but none of the shipped clients do.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# -----------------------------------------------------------------------------
# Deepgram (Required, bot)
# -----------------------------------------------------------------------------
# Speech-to-text (Deepgram Flux)
# https://console.deepgram.com/
DEEPGRAM_API_KEY=<your-deepgram-api-key>

# -----------------------------------------------------------------------------
# Cartesia (Required, bot)
# -----------------------------------------------------------------------------
# Text-to-speech (Cartesia Sonic)
# https://play.cartesia.ai/
CARTESIA_API_KEY=<your-cartesia-api-key>

# -----------------------------------------------------------------------------
# Daily (Required)
# -----------------------------------------------------------------------------
# Rooms, telephony and SIP transfer
# https://dashboard.daily.co/developers
DAILY_API_KEY=<your-daily-api-key>

# ID of the Daily phone number used for dial-out. Every shipped services.yaml
# references it, so the bot fails to build a pipeline without it.
DAILY_PHONE_NUMBER_ID=<your-daily-phone-number-id>

# Seconds to wait for Daily room creation (optional)
DAILY_ROOM_TIMEOUT=15

# -----------------------------------------------------------------------------
# Pipecat Cloud (Required when ENV is "test" or "production")
# -----------------------------------------------------------------------------
# https://pipecat.daily.co/
# PIPECAT_API_KEY=<your-pipecat-api-key>

# Name of the deployed Pipecat Cloud agent (optional, defaults to healthcare-voice-ai)
# PIPECAT_AGENT_NAME=healthcare-voice-ai

# Seconds to wait for the bot to start, local or cloud (optional)
BOT_START_TIMEOUT=30

# -----------------------------------------------------------------------------
# Local bot server (ENV=local)
# -----------------------------------------------------------------------------
# Port bot.py listens on
BOT_PORT=7860

# URL the backend uses to start the local bot
LOCAL_BOT_URL=http://localhost:7860

# -----------------------------------------------------------------------------
# Langfuse and OpenTelemetry (Optional)
# -----------------------------------------------------------------------------
# Langfuse credentials: tracing from the bot and evals, and scripts/analyze_call.py
# https://langfuse.com/
# LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
# LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>

# Langfuse host (the admin API defaults to https://us.cloud.langfuse.com)
# LANGFUSE_HOST=https://cloud.langfuse.com

# Langfuse project ID, used for the trace links in the admin call view
# LANGFUSE_PROJECT_ID=<your-langfuse-project-id>

# Enable OpenTelemetry tracing in the bot (true/false)
ENABLE_TRACING=false

# Also print traces to the console (true/false)
OTEL_CONSOLE_EXPORT=false

# OTLP exporter settings, read by the OpenTelemetry SDK when ENABLE_TRACING=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>

# Enable the Whisker pipeline debugger; only takes effect when DEBUG=true (true/false)
ENABLE_WHISKER=false

# -----------------------------------------------------------------------------
# Email alerts (Optional)
# -----------------------------------------------------------------------------
# SMTP server for error alert emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=<your-smtp-username>
# SMTP_PASSWORD=<your-smtp-app-password>

# Comma-separated list of addresses that receive alerts
# ALERT_RECIPIENTS=<alerts@example.com>

# -----------------------------------------------------------------------------
# AssemblyAI (Optional)
# -----------------------------------------------------------------------------
# Transcribes uploaded call recordings in the onboarding API (backend/services/transcription.py)
# ASSEMBLYAI_API_KEY=<your-assemblyai-api-key>

# -----------------------------------------------------------------------------
# ElevenLabs (Optional)
# -----------------------------------------------------------------------------
# Only used by validate.py for a connectivity check and by sync-secrets.sh.
# No shipped client uses ElevenLabs for TTS.
# ELEVENLABS_API_KEY=<your-elevenlabs-api-key>
