# Generated at build/CI time from uv.local.lock / uv.api.lock / uv.bot.lock
/uv.lock

# Python cache (regenerated on import)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# IDE swap files
*.swp
*.swo

# Build artifacts
frontend/build/
frontend/node_modules/

# Environment / secrets
.env
.env.*
!.env.example
!frontend/.env.example

# Internal/generated data not meant for the public repo
combined_daily.csv

# Local dev run logs
.dev-logs/

# Demo audio (large binaries, don't belong in git)
scripts/audio/*.mp3
clients/*/*/recordings/*.mp3
